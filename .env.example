API_KEY=demo-key
DATABASE_URL=sqlite:///./cino_hr.db
# Phase2: merge position roles into effective roles on login/me
SYNC_ROLES_FROM_POSITION=true

# Phase5 files: local | s3 | database
FILE_STORAGE_BACKEND=local
# Local default; Docker compose sets /data/files on the hr_data volume
FILE_LOCAL_DIR=/workspace/cino-hr-api/data/files
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Phase5 SSO OIDC (optional; password login always works)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/sso/callback
OIDC_FRONTEND_REDIRECT=http://127.0.0.1:5173/login

# Phase5 notifications (missing => dry-run log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cino.demo
WECOM_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
SMS_PROVIDER=demo
